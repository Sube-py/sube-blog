# ============================================================
.idea/
*.swp
*.swo
*~
*.iml
.project
.classpath
.settings/

# VS Code：忽略个人配置，保留可共享的推荐配置
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ============================================================
#  密钥 / 本地凭证（重要）
# ============================================================
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.token
credentials.json
service-account*.json
.secrets/
.netrc

# ============================================================
#  杂项
