# ============================================================
#  macOS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# macOS 缩略图 / 索引
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# 外接盘 / 网络盘残留
.AppleDB
.AppleDesktop
Network Trash Folder

# Windows（偶尔跨平台时有用）
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
#  Hugo
# ============================================================
public/                 # 构建产物，由 CI 生成，不要提交
resources/              # Hugo 缓存（图片处理、资源管道）
.hugo_build.lock
hugo_stats.json         # 构建统计，每次都变
.hugo_build/

# ============================================================
#  Python（后端 / LLM 应用 / Agent）
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# 测试 / 类型检查 / lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Jupyter（调模型时常用）
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML / 大模型相关（避免误提交大文件）
*.gguf
*.bin
