# 备用方案：当 EdgeOne Pages 的构建镜像里没有 Hugo 时使用
# 用法：把本文件复制到 .github/workflows/deploy.yml，改掉项目名即可
#
# 前置：
#   1. 在 EdgeOne 控制台生成 API Token（https://edgeone.cloud.tencent.com/pages → API Token）
#   2. 在 GitHub 仓库 Settings → Secrets → Actions 添加 EDGEONE_API_TOKEN
#   3. EdgeOne 项目改为「直接上传」方式创建，或停用其自动构建

name: Build & Deploy to EdgeOne Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0          # Hugo 需要 git 信息算最后修改时间

      - name: Setup Hugo
        uses: peaceiris/actions-hugo@v3
        with:
          hugo-version: '0.146.0' # 建议锁版本，避免构建行为突变
          extended: false

      - name: Build
        run: hugo --minify --gc

      - name: Deploy to EdgeOne Pages
        run: npx edgeone pages deploy ./public -n 你的EdgeOne项目名 -t ${{ secrets.EDGEONE_API_TOKEN }}
